  "type": "module",
  "license": "MIT",
  "author": "Elias Alfaro",
  "homepage": "https://github.com/elalfner/relevo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elalfner/relevo.git"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "workflow",
    "agents",
    "openspec"
  ],
  "bin": {
